<?php

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\LucideIcons;
use Magento\Framework\Escaper;

/** @var \Forever\Core\Block\CategoryList|\Forever\Core\Block\BestsellerProduct $block */
/** @var ViewModelRegistry $viewModels */
/** @var Escaper $escaper */

if (!$block->isModuleEnabled()) {
    return;
}

$selectedCategory = $block->getSelectedCategory();
if (!$selectedCategory) {
    return;
}

$lucideIcons = $viewModels->require(LucideIcons::class);
$authPopupEnabled = method_exists($block, 'getAuthenticationpopup') && (int) $block->getAuthenticationpopup() === 1;

$resetPriceListState = static function () use ($block): void {
    $priceRenderer = $block->getLayout()->getBlock('product.price.render.default');
    if ($priceRenderer) {
        $priceRenderer->setData('is_product_list', false);
        $priceRenderer->unsetData('special_price_map');
    }
};

$getOriginalImageUrl = static function ($product): string {
    $imageFile = (string) ($product->getSmallImage() ?: $product->getImage() ?: $product->getThumbnail());
    if (!$imageFile || $imageFile === 'no_selection') {
        $imageFile = (string) ($product->getImage() ?: $product->getThumbnail());
    }

    return $imageFile && $imageFile !== 'no_selection'
        ? (string) $product->getMediaConfig()->getMediaUrl($imageFile)
        : '';
};

$renderProductCard = static function ($product) use ($block, $escaper, $lucideIcons, $authPopupEnabled, $getOriginalImageUrl): string {
    $productId = (int) $product->getId();
    $productName = (string) $product->getName();
    $productUrl = (string) $product->getProductUrl();
    $imageUrl = $getOriginalImageUrl($product);
    $imageSwitcherEnabled = method_exists($block, 'getImageSwitcherConfigValue')
        && (bool) $block->getImageSwitcherConfigValue();
    $switcherImageUrl = $imageSwitcherEnabled && method_exists($block, 'getImageUrl')
        ? (string) $block->getImageUrl($product)
        : '';
    $productLabels = method_exists($block, 'getProductlabel') ? (array) $block->getProductlabel($product) : [];
    $ratingSummary = (int) ($product->getRatingSummary() ?: $product->getData('rating_summary') ?: 0);
    $filledStars = max(0, min(5, (int) round($ratingSummary / 20)));
    $priceHtml = method_exists($block, 'getProductPricetoHtml')
        ? (string) $block->getProductPricetoHtml($product)
        : (method_exists($block, 'getProductPrice') ? (string) $block->getProductPrice($product) : '');

    ob_start();
?>
    <article class="forever-product-card"
        data-product-url="<?= $escaper->escapeUrl($productUrl) ?>"
        @click="openProduct($event)">
        <div class="forever-product-image-wrap">
            <?php if ($productLabels): ?>
                <div class="product_label_wrapper top_right">
                    <?php foreach ($productLabels as $productLabel): ?>
                        <?php if ($productLabel): ?>
                            <span class="productlabel <?= $escaper->escapeHtmlAttr(is_numeric($productLabel) ? 'discount' : strtolower(str_replace(' ', '', (string) $productLabel))) ?>">
                                <?= $escaper->escapeHtml(is_numeric($productLabel) ? $productLabel . '% off' : (string) $productLabel) ?>
                            </span>
                        <?php endif; ?>
                    <?php endforeach; ?>
                </div>
            <?php endif; ?>
            <?php if ($imageSwitcherEnabled && $imageUrl && $switcherImageUrl): ?>
                <div class="forever-product-flip-box">
                    <div class="forever-product-flip-inner">
                        <a class="forever-product-image-link forever-product-flip-face forever-product-flip-front" href="<?= $escaper->escapeUrl($productUrl) ?>">
                            <img class="forever-product-image"
                                src="<?= $escaper->escapeUrl($imageUrl) ?>"
                                alt="<?= $escaper->escapeHtmlAttr($productName) ?>"
                                loading="lazy"
                                width="600"
                                height="600">
                        </a>
                        <a class="forever-product-image-link forever-product-flip-face forever-product-flip-back" href="<?= $escaper->escapeUrl($productUrl) ?>">
                            <img class="forever-product-image"
                                src="<?= $escaper->escapeUrl($switcherImageUrl) ?>"
                                alt="<?= $escaper->escapeHtmlAttr($productName) ?>"
                                loading="lazy"
                                width="600"
                                height="600">
                        </a>
                    </div>
                </div>
            <?php else: ?>
                <a class="forever-product-image-link" href="<?= $escaper->escapeUrl($productUrl) ?>">
                    <?php if ($imageUrl): ?>
                        <img class="forever-product-image"
                            src="<?= $escaper->escapeUrl($imageUrl) ?>"
                            alt="<?= $escaper->escapeHtmlAttr($productName) ?>"
                            loading="lazy"
                            width="600"
                            height="600">
                    <?php endif; ?>
                </a>
            <?php endif; ?>
            <div class="forever-product-actions">
                <?php if ($product->isSaleable()): ?>
                    <?php $postParams = $block->getAddToCartPostParams($product); ?>
                    <form action="<?= $escaper->escapeUrl($postParams['action']) ?>" method="post" data-role="tocart-form" @click.stop>
                        <input type="hidden" name="product" value="<?= $escaper->escapeHtmlAttr((string) $postParams['data']['product']) ?>">
                        <input type="hidden" name="uenc" value="<?= $escaper->escapeHtmlAttr((string) $postParams['data']['uenc']) ?>">
                        <?= $block->getBlockHtml('formkey') ?>
                        <button class="forever-product-action forever-cart-action" type="submit" data-addto="cart" title="<?= $escaper->escapeHtmlAttr(__('Add to Cart')) ?>">
                            <span><?= $escaper->escapeHtml(__('Add to Cart')) ?></span>
                            <?= $lucideIcons->shoppingCartHtml('', 18, 18, ['aria-hidden' => 'true']) ?>
                        </button>
                    </form>
                <?php else: ?>
                    <a class="forever-product-action forever-cart-action" href="<?= $escaper->escapeUrl($productUrl) ?>" title="<?= $escaper->escapeHtmlAttr(__('Configure')) ?>">
                        <span><?= $escaper->escapeHtml(__('Configure')) ?></span>
                        <?= $lucideIcons->pencilHtml('', 18, 18, ['aria-hidden' => 'true']) ?>
                    </a>
                <?php endif; ?>
                <?php if ($authPopupEnabled): ?>
                    <button
                        x-data="initForeverHomeWishlist()"
                        x-defer="intersect"
                        @click.prevent.stop="addProductToWishlist(<?= (int) $productId ?>)"
                        class="forever-product-action forever-wishlist-action cursor-pointer"
                        type="button"
                        data-forever-wishlist
                        data-product-id="<?= (int) $productId ?>"
                        data-action="add-to-wishlist"
                        data-addto="wishlist"
                        title="<?= $escaper->escapeHtmlAttr(__('Add to Wish List')) ?>"
                        aria-label="<?= $escaper->escapeHtmlAttr(__('Add to Wish List')) ?>"
                    >
                        <span><?= $escaper->escapeHtml(__('Add to Wish List')) ?></span>
                        <?= $lucideIcons->heartHtml('', 18, 18, ['aria-hidden' => 'true']) ?>
                    </button>
                <?php else: ?>
                    <button
                        x-data="initForeverHomeWishlist()"
                        x-defer="intersect"
                        @click.prevent.stop="addToWishlist(<?= (int) $productId ?>)"
                        class="forever-product-action forever-wishlist-action cursor-pointer"
                        data-addto="wishlist"
                        title="<?= $escaper->escapeHtmlAttr(__('Add to Wish List')) ?>"
                        aria-label="<?= $escaper->escapeHtmlAttr(__('Add to Wish List')) ?>"
                    >
                        <span><?= $escaper->escapeHtml(__('Add to Wish List')) ?></span>
                        <?= $lucideIcons->heartHtml('', 18, 18, ['aria-hidden' => 'true']) ?>
                    </button>
                <?php endif; ?>
                <a class="forever-product-action forever-compare-action" href="#" data-post='<?=
                                                                        /** @noEscape */
                                                                        $block->getCompareHelper()->getPostDataParams($product) ?>' title="<?= $escaper->escapeHtmlAttr(__('Add to Compare')) ?>">
                    <span><?= $escaper->escapeHtml(__('Add To Compare')) ?></span>
                    <?= $lucideIcons->refreshCwHtml('', 18, 18, ['aria-hidden' => 'true']) ?>
                </a>
            </div>
        </div>
        <div class="forever-product-info">
            <a class="forever-product-name" href="<?= $escaper->escapeUrl($productUrl) ?>">
                <?= $escaper->escapeHtml($productName) ?>
            </a>
            <div class="forever-product-rating" aria-label="<?= $escaper->escapeHtmlAttr(__('%1 out of 5 stars', $filledStars)) ?>">
                <?php for ($i = 1; $i <= 5; $i++): ?>
                    <span class="<?= $i <= $filledStars ? 'is-filled' : '' ?>">★</span>
                <?php endfor; ?>
            </div>
            <div class="forever-product-price">
                <?=
                /** @noEscape */
