declare(strict_types=1);

use Magento\Catalog\Block\Product\Image;
use Magento\Framework\Escaper;

/** @var Image $block */
/** @var Escaper $escaper */

$customAttributes = $block->getCustomAttributes();
$src = $block->getImageUrl();
if (is_array($customAttributes) && isset($customAttributes['data-src'])) {
    $src = $customAttributes['data-src'];
    unset($customAttributes['data-src']);
} elseif (is_string($customAttributes) && preg_match('/data-src="([^"]+)"/', $customAttributes, $matches)) {
    $src = $matches[1];
    $customAttributes = preg_replace('/data-src="[^"]+"/', '', $customAttributes);
}
?>
<img
    src="<?= $escaper->escapeUrl($src) ?>"
    width="<?= $escaper->escapeHtmlAttr($block->getWidth()) ?>"
    height="<?= $escaper->escapeHtmlAttr($block->getHeight()) ?>"
    alt="<?= $escaper->escapeHtmlAttr($block->getLabel()) ?>"
    loading="lazy"
    class="photo image <?= $escaper->escapeHtmlAttr($block->getClass()) ?>"
    <?php if (is_string($customAttributes)): ?>
        <?= /* @noEscape */ $customAttributes ?>
    <?php elseif (is_array($customAttributes)): ?>
        <?php foreach ($customAttributes as $name => $value): ?>
            <?= $escaper->escapeHtmlAttr($name) ?>="<?= $escaper->escapeHtmlAttr($value) ?>"
        <?php endforeach; ?>
    <?php endif; ?>
>
