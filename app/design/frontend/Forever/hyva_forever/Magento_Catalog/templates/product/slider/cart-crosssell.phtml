        }
    }
</style>

<section
    id="forever-cart-crosssell-static"
    class="forever-cart-crosssell-static"
    aria-label="<?= $escaper->escapeHtmlAttr($title) ?>"
>
    <h2 class="forever-cart-crosssell-static-title">
        <?= $escaper->escapeHtml($title) ?>
    </h2>
    <div class="forever-cart-crosssell-static-rule" aria-hidden="true"></div>

    <div class="forever-cart-crosssell-static-grid">
        <?php foreach ($items as $product): ?>
            <div class="forever-cart-crosssell-static-item">
                <?= /** @noEscape */ $productListItemViewModel->getItemHtmlWithRenderer(
                    $itemRenderer,
                    $product,
                    $block,
                    'grid',
                    ProductReviewRenderer::SHORT_VIEW,
                    'category_page_grid',
                    false
                ) ?>
            </div>
        <?php endforeach; ?>
    </div>
</section>
