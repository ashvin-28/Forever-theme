        .checkout-cart-index .forever-cart-crosssell-static .forever-category-product-media,
        .checkout-cart-index .forever-cart-crosssell-static .forever-category-product-image-link,
        .checkout-cart-index .forever-cart-crosssell-static .forever-category-product-flip,
        .checkout-cart-index .forever-cart-crosssell-static .forever-category-product-flip-inner,
        .checkout-cart-index .forever-cart-crosssell-static .forever-category-product-flip-face {
            min-height: 300px;
        }

        .checkout-cart-index .forever-cart-crosssell-static .forever-category-product-image,
        .checkout-cart-index .forever-cart-crosssell-static .forever-category-product-image-link img,
        .checkout-cart-index .forever-cart-crosssell-static .forever-category-product-media img {
            height: 238px;
        }

        .checkout-cart-index .forever-cart-crosssell-static .forever-category-product-actions {
            opacity: 1;
