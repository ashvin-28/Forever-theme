<?php
declare(strict_types=1);

use Forever\Dailydeals\Block\Dailydeals;
use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HyvaCsp;
use Magento\Catalog\Model\Product;
use Magento\Framework\Escaper;

/** @var Dailydeals $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */
/** @var HyvaCsp $hyvaCsp */

$hyvaCsp = $viewModels->require(HyvaCsp::class);
if (!$block->isEnable() || !$block->isProductAvailable()) {
    return;
}

$timezone = $block->getConfigTimeZone() ?: 'UTC';
$product = $block->getSpecificProduct();
$expDateTimeRaw = (string) $block->getConfigExpDateTime();

if (!$product instanceof Product || $expDateTimeRaw === '') {
    return;
}

try {
    $tz = new DateTimeZone($timezone);
    $now = new DateTimeImmutable('now', $tz);
    $expDateTime = new DateTimeImmutable($expDateTimeRaw, $tz);
} catch (Throwable $exception) {
    return;
}

if ($expDateTime <= $now) {
    return;
}

$stockItem = $product->getExtensionAttributes() ? $product->getExtensionAttributes()->getStockItem() : null;
if (!$stockItem || !$stockItem->getIsInStock()) {
    return;
}

$type = (string) $product->getTypeId();
$imageUrl = $block->getProductImage($product);
$addToCartUrl = $block->getAddCartUrl($product);
$buttonText = (string) ($block->getConfigButtonText() ?: __('Order Now'));
$saleText = (string) ($block->getConfigSaleText() ?: __('Take advantage of huge <b>discount</b>'));
$isDirectCartType = in_array($type, ['simple', 'downloadable', 'virtual'], true);
$regularPrice = '';
$specialPrice = '';
$displayPrice = '';

if ($isDirectCartType) {
    $regularPrice = $block->getFormatedPrice((float) $product->getPrice());
    $specialPriceValue = (float) $product->getSpecialPrice();
    $specialPrice = $specialPriceValue > 0 ? $block->getFormatedPrice($specialPriceValue) : '';
    $displayPrice = $specialPrice !== '' ? $specialPrice : $regularPrice;
} elseif ($type === 'configurable') {
    $price = $product->getPriceInfo()->getPrice('regular_price');
    $displayPrice = (string) __('As low as %1', $block->getFormatedPrice($price->getMinRegularAmount()->getValue()));
} elseif ($type === 'bundle') {
    $price = $product->getPriceInfo()->getPrice('final_price');
    $displayPrice = (string) __('From %1', $block->getFormatedPrice($price->getMinimalPrice()->getValue()));
} elseif ($type === 'grouped') {
    $price = $product->getPriceInfo()->getPrice('final_price');
    $displayPrice = $block->getFormatedPrice($price->getMinimalPrice()->getValue());
}

$dealConfig = [
    'expiresAt' => $expDateTime->format(DATE_ATOM),
    'labels' => [
        'days' => (string) __('DAYS'),
        'hours' => (string) __('HRS'),
        'minutes' => (string) __('MINS'),
        'seconds' => (string) __('SECS'),
    ],
];
$dealConfigJson = json_encode($dealConfig, JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP);
?>

<script>
    'use strict';

    function initForeverDailyDeal(config) {
        return {
            endTime: new Date(config.expiresAt).getTime(),
            expired: false,
            sticky: false,
            stickyStart: 0,
            timer: null,
            parts: {
                days: '0',
                hours: '00',
                minutes: '00',
                seconds: '00'
            },
            labels: config.labels,

            init() {
                this.refresh();
                this.timer = window.setInterval(() => this.refresh(), 1000);
                this.$nextTick(() => {
                    this.updateStickyStart();
                    this.updateStickyState();
                });
                window.addEventListener('resize', () => this.updateStickyStart(), {passive: true});
                window.addEventListener('scroll', () => this.updateStickyState(), {passive: true});
            },

            destroy() {
                if (this.timer) {
                    window.clearInterval(this.timer);
                }
            },

            refresh() {
                const distance = this.endTime - Date.now();
                if (distance <= 0) {
                    this.expired = true;
                    this.sticky = false;
                    this.destroy();
                    return;
                }

                const second = 1000;
                const minute = second * 60;
                const hour = minute * 60;
                const day = hour * 24;

                this.parts.days = String(Math.floor(distance / day));
                this.parts.hours = this.pad(Math.floor((distance % day) / hour));
                this.parts.minutes = this.pad(Math.floor((distance % hour) / minute));
                this.parts.seconds = this.pad(Math.floor((distance % minute) / second));
            },

            updateStickyStart() {
                if (!this.$el) {
                    return;
                }
                this.stickyStart = this.$el.getBoundingClientRect().top + window.scrollY;
            },

            updateStickyState() {
                this.sticky = !this.expired && window.scrollY > this.stickyStart;
            },

            pad(value) {
                return String(value).padStart(2, '0');
            }
        };
    }
</script>
<?php $hyvaCsp->registerInlineScript() ?>

