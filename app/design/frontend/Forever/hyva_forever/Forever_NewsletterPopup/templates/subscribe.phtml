<script>
    function initForeverNewsletterPopup() {
        return {
            open: false,
            cookieMinutes: 1440,
            init() {
                this.$el.classList.remove('hidden');

                if (this.hasCookie()) {
                    return;
                }

                window.setTimeout(() => this.show(), 600);
            },
            show() {
                if (this.hasCookie()) {
                    return;
                }

                this.open = true;
                this.setCookie();
                document.body.classList.add('forever-newsletter-visible');
            },
            close() {
                this.open = false;
                document.body.classList.remove('forever-newsletter-visible');
            },
            cookieName() {
                return this.$el.dataset.cookieName || 'news_letter_popup';
            },
            hasCookie() {
                const name = `${this.cookieName()}=`;

                return document.cookie.split('; ').some((cookie) => cookie.indexOf(name) === 0);
            },
            setCookie() {
                const expires = new Date();
                expires.setTime(expires.getTime() + (this.cookieMinutes * 60 * 1000));
                document.cookie = `${this.cookieName()}=popupshow; expires=${expires.toUTCString()}; path=/; SameSite=Lax`;
            }
        }
    }

    window.addEventListener('alpine:init', () => {
        Alpine.data('initForeverNewsletterPopup', initForeverNewsletterPopup)
    }, {once: true})
</script>
<?php $hyvaCsp->registerInlineScript() ?>

