<?php
/**
 * Hyva compatibility for Forever_Lazyload.
 * This template overrides the RequireJS/jQuery-based loader with a modern IntersectionObserver implementation.
 */
$helper = $this->helper(Forever\Lazyload\Helper\Filter::class);
$delay = (int) $helper->getConfig('lazyload/general/lazyload_delay');
$effect = (string) $helper->getConfig('lazyload/general/lazyload_effect');
$effectTime = (int) $helper->getConfig('lazyload/general/lazyload_effecttime');
$isEnable = (int) $helper->getConfig('lazyload/general/enable');
?>
<?php if ($isEnable): ?>
    <?php if ($effect === 'fadeIn'): ?>
    <style>
        img.lazy, iframe.lazy {
            transition: opacity <?= $effectTime ? $effectTime : 400 ?>ms ease-in-out;
        }
        img.lazy.lazy-swapping {
            opacity: 0;
        }
    </style>
    <?php endif; ?>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const loadElement = function(element) {
                let loaded = false;
                const onImageLoad = function() {
                    if (loaded) return;
                    loaded = true;
                    element.classList.remove('lazy-loading', 'lazy-swapping');
                    element.classList.add('lazy-loaded');
                };

                if (element.tagName === 'IMG') {
                    element.classList.add('lazy-swapping');
                    element.addEventListener('load', onImageLoad, { once: true });
                    element.addEventListener('error', onImageLoad, { once: true });
                    setTimeout(onImageLoad, 3000); // Safety fallback
                    if (element.complete) {
                        onImageLoad();
                    }
                } else {
                    onImageLoad();
                }

                if (element.dataset.src) {
                    element.src = element.dataset.src;
                    delete element.dataset.src;
                }
                if (element.dataset.srcset) {
                    element.srcset = element.dataset.srcset;
                    delete element.dataset.srcset;
                }
            };

            if ('IntersectionObserver' in window) {
                const observer = new IntersectionObserver(function(entries, observer) {
                    entries.forEach(function(entry) {
                        if (entry.isIntersecting) {
                            const element = entry.target;
                            <?php if ($delay > 0): ?>
                            setTimeout(function() {
                                loadElement(element);
                            }, <?= $delay ?>);
                            <?php else: ?>
                            loadElement(element);
                            <?php endif; ?>
                            observer.unobserve(element);
                        }
                    });
                }, {
                    rootMargin: '200px 0px',
                    threshold: 0.01
                });

                // Observe existing elements
                document.querySelectorAll('img.lazy, iframe.lazy').forEach(function(element) {
                    observer.observe(element);
                });

                // Watch for dynamically added lazy elements (e.g. via sliders, AJAX, widgets)
                const mutationObserver = new MutationObserver(function(mutations) {
                    mutations.forEach(function(mutation) {
                        mutation.addedNodes.forEach(function(node) {
                            if (node.nodeType === Node.ELEMENT_NODE) {
                                if (node.matches && node.matches('img.lazy, iframe.lazy')) {
                                    observer.observe(node);
                                }
                                if (node.querySelectorAll) {
                                    node.querySelectorAll('img.lazy, iframe.lazy').forEach(function(child) {
                                        observer.observe(child);
                                    });
                                }
                            }
                        });
                    });
                });

                mutationObserver.observe(document.body, {
                    childList: true,
                    subtree: true
                });
            } else {
                // Fallback for older browsers
                document.querySelectorAll('img.lazy, iframe.lazy').forEach(function(element) {
                    loadElement(element);
                });
            }
        });
    </script>
<?php endif; ?>
