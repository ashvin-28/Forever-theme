<?php if ($block->canShowBlock()): ?>
    <?php
    $filters = $block->getFilters();
    $filtered = count($block->getLayer()->getState()->getFilters());
    ?>
    <div
        class="block filter forever-layered-filter"
        id="layerednav-filter-block"
        x-data="{ mobileOpen: false, active: null }"
        @keydown.escape.window="active = null; mobileOpen = false"
    >
        <button
            type="button"
            class="block-title filter-title"
            data-count="<?= $block->escapeHtmlAttr((string) $filtered) ?>"
            :aria-expanded="mobileOpen ? 'true' : 'false'"
            @click="mobileOpen = !mobileOpen"
        >
            <strong><?= $block->escapeHtml(__('Shop By')) ?></strong>
        </button>

        <div
            class="block-content filter-content sidebar-shop sidebar-left"
            :class="{ 'is-open': mobileOpen }"
        >
            <?php if ($block->getLayer()->getState()->getFilters()): ?>
                <div class="forever-filter-state">
                    <?= /** @noEscape */ $block->getChildHtml('state') ?>
                    <div class="block-actions filter-actions">
                        <a href="<?= $block->escapeUrl($block->getClearUrl()) ?>" class="action clear filter-clear">
                            <span><?= $block->escapeHtml(__('Clear All')) ?></span>
                        </a>
                    </div>
                </div>
            <?php endif; ?>

            <?php $wrapOptions = false; ?>
            <?php foreach ($filters as $filter): ?>
                <?php if ($filter->getItemsCount()): ?>
                    <?php if (!$wrapOptions): ?>
                        <strong role="heading" aria-level="2" class="block-subtitle filter-subtitle">
                            <?= $block->escapeHtml(__('Shopping Options')) ?>
                        </strong>
                        <div class="gradient-accordion">
                        <div class="filter-options" id="narrow-by-list">
                        <?php $wrapOptions = true; ?>
                    <?php endif; ?>
                    <?php
                    $requestVar = (string) $filter->getRequestVar();
                    $filterId = 'filter-' . preg_replace('/[^a-z0-9_-]+/i', '-', $requestVar);
                    ?>
                    <div
                        class="filter-options-item"
                        attribute="<?= $block->escapeHtmlAttr($requestVar) ?>"
                        :class="{ 'active': active === '<?= $block->escapeJs($filterId) ?>' }"
                        @click.outside="if (active === '<?= $block->escapeJs($filterId) ?>') active = null"
                    >
                        <button
                            type="button"
                            class="filter-options-title"
                            :aria-expanded="active === '<?= $block->escapeJs($filterId) ?>' ? 'true' : 'false'"
                            aria-controls="<?= $block->escapeHtmlAttr($filterId) ?>"
                            @click="active = active === '<?= $block->escapeJs($filterId) ?>' ? null : '<?= $block->escapeJs($filterId) ?>'"
                        >
                            <?= $block->escapeHtml(__($filter->getName())) ?>
                        </button>
                        <div
                            class="filter-options-content"
                            id="<?= $block->escapeHtmlAttr($filterId) ?>"
                            x-show="active === '<?= $block->escapeJs($filterId) ?>'"
                            x-cloak
                        >
                            <?= /** @noEscape */ $block->getChildBlock('renderer')->setFilter($filter)->render($filter); ?>
                        </div>
                    </div>
                <?php endif; ?>
            <?php endforeach; ?>

            <?php if ($wrapOptions): ?>
                </div>
                </div>
            <?php else: ?>
                <div class="filter-no-options"></div>
            <?php endif; ?>
        </div>
    </div>
<?php endif; ?>
