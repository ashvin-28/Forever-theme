$lucideIcons = $viewModels->require(LucideIcons::class);
$storeConfig = $viewModels->require(StoreConfig::class);

$menuConfig = is_array($block->_sysCfg->module ?? null) ? $block->_sysCfg->module : [];
$homeConfig = is_array($block->_sysCfg->homebutton ?? null) ? $block->_sysCfg->homebutton : [];
$desktopConfig = is_array($block->_sysCfg->desktop ?? null) ? $block->_sysCfg->desktop : [];
$mobileConfig = is_array($block->_sysCfg->mobile ?? null) ? $block->_sysCfg->mobile : [];

$isEnabled = (bool) (int) ($storeConfig->getStoreConfig('megamenu/module/enabled') ?? ($menuConfig['enabled'] ?? 0));
