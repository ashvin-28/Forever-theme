            </nav>
            <nav class="forever-mobile-account-links"
                 aria-label="<?= $escaper->escapeHtmlAttr(__('Account links')) ?>"
                 x-show.important="mobileTab === 'account'">
                <a href="<?= $escaper->escapeUrl($block->getUrl('customer/account/login')) ?>">
                    <?= $escaper->escapeHtml(__('Sign In')) ?>
                </a>
                <a href="<?= $escaper->escapeUrl($block->getUrl('customer/account/create')) ?>">
                    <?= $escaper->escapeHtml(__('Create an Account')) ?>
                </a>
            </nav>
        </div>
    </div>
    <?php
    return;
}

$homeHtml = $showHome ? $block->drawHomeMenu() : '';
$extraHtml = $block->drawExtraMenu();
$mainMenu = $block->drawMainMenu();
$desktopHtml = implode("\n", (array) ($mainMenu['desktop'] ?? []));
$mobileHtml = trim((string) ($mainMenu['mobile'] ?? ''));
$fallbackItemsHtml = $buildFallbackMenuItemsHtml();

if ($desktopHtml === '' && $mobileHtml === '') {
    $desktopHtml = $fallbackItemsHtml;
    $mobileHtml = $desktopHtml;
} elseif ($mobileHtml === '') {
    $mobileHtml = trim($desktopHtml ?: $fallbackItemsHtml);
} elseif ($desktopHtml === '') {
    $desktopHtml = trim($mobileHtml ?: $fallbackItemsHtml);
}
$desktopItemsHtml = trim($homeHtml . "\n" . $desktopHtml . "\n" . $extraHtml);
$mobileItemsHtml = trim($homeHtml . "\n" . $mobileHtml . "\n" . $extraHtml);

if (!$showHome) {
    $desktopItemsHtml = $removeHomeMenuItem($desktopItemsHtml);
    $mobileItemsHtml = $removeHomeMenuItem($mobileItemsHtml);
}

if ($desktopItemsHtml === '') {
    return;
}

if ($mobileItemsHtml === '') {
    $mobileItemsHtml = $desktopItemsHtml;
}

if (!$hasMenuItems($mobileItemsHtml) && $hasMenuItems($fallbackItemsHtml)) {
    $mobileItemsHtml = $fallbackItemsHtml;
}

$mobileItemsHtml = $decorateMobileMenu($mobileItemsHtml, $mobileClass);
@file_put_contents(BP . '/var/log/megamenu_debug.html', $mobileItemsHtml);
