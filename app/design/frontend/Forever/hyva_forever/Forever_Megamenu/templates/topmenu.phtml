                        @click="mobileTab = 'account'">
                    <?= $escaper->escapeHtml(__('Account')) ?>
                </button>
            </div>
            <nav class="navigation mean-nav forever-navigation-mobile <?= $escaper->escapeHtmlAttr($mobileClass) ?>"
                role="navigation"
                aria-label="<?= $escaper->escapeHtmlAttr(__('Mobile menu')) ?>"
                x-show.important="mobileTab === 'menu'">
                <ul class="nav-mobile">
