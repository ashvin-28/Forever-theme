{
  "name": "@forever/hyva-forever-theme",
  "version": "1.0.0",
  "description": "Tailwind build for the Forever Hyva child theme.",
  "type": "module",
  "private": true,
  "dependencies": {
    "@hyva-themes/hyva-modules": "^1.3.0",
    "@tailwindcss/cli": "^4.1.17",
    "tailwindcss": "^4.1.17"
  },
  "scripts": {
    "generate:sources": "node node_modules/@hyva-themes/hyva-modules/bin/generate-sources.js",
    "generate:tokens": "node node_modules/@hyva-themes/hyva-modules/bin/generate-tokens.js",
    "generate": "npm run generate:sources && npm run generate:tokens",
    "prebuild": "npm run generate",
    "build": "node node_modules/@tailwindcss/cli/dist/index.mjs -i tailwind-source.css -o ../css/styles.css --minify",
    "prewatch": "npm run generate",
    "watch": "node node_modules/@tailwindcss/cli/dist/index.mjs -i tailwind-source.css -o ../css/styles.css --watch"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
