<?php
/** @var \Magento\Wishlist\Block\Catalog\Product\View\AddTo\Wishlist $block */
$viewModel = $block->getViewmodels();
$enabled = $viewModel && (int) $viewModel->getScopeconfig() === 1;
$params = $block->getWishlistParams();
$productId = (int) (json_decode($params, true)['data']['product'] ?? 0);
?>
<?php if ($block->isWishListAllowed()): ?>
    <a href="#"
       class="action towishlist"
       title="<?= $block->escapeHtmlAttr(__('Add to Wish List')) ?>"
       aria-label="<?= $block->escapeHtmlAttr(__('Add to Wish List')) ?>"
       <?php if ($enabled): ?>
           data-forever-wishlist
           data-product-id="<?= $block->escapeHtmlAttr($productId) ?>"
       <?php else: ?>
           data-post='<?= /* @noEscape */ $params ?>'
       <?php endif; ?>
       data-action="add-to-wishlist"
       role="button">
        <span><?= $block->escapeHtml(__('Add to Wish List')) ?></span>
    </a>
<?php endif; ?>
