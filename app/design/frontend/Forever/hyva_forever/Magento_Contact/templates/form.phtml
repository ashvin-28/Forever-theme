<?php
/**
 * Hyva contact form styled for the Forever furniture contact page.
 */

declare(strict_types=1);

use Hyva\Theme\ViewModel\ReCaptcha;
use Magento\Contact\Block\ContactForm;
use Magento\Contact\Helper\Data as ContactHelper;
use Magento\Framework\Escaper;

/** @var ContactForm $block */
/** @var Escaper $escaper */
/** @var ReCaptcha|null $recaptcha */

$formId = 'contact';
/** @var ContactHelper $contactHelper */
$contactHelper = $this->helper(ContactHelper::class);
$recaptcha = $block->getData('viewModelRecaptcha');
$contactAddressHtml = trim((string) $block->getChildHtml('contact.address'));
$contactDetailsHtml = trim((string) $block->getChildHtml('contact.details'));
?>
<section class="forever-contact-wrap">
    <div class="forever-contact-inner">
        <form
            class="form contact forever-contact-form"
            action="<?= $escaper->escapeUrl($block->getFormAction()) ?>"
            id="<?= $escaper->escapeHtmlAttr($formId) ?>"
            method="post"
            x-data="initContactForm()"
            @submit.prevent="submitForm()"
        >
            <fieldset class="forever-contact-fieldset">
                <div class="forever-contact-form-heading">
                    <h2><?= $escaper->escapeHtml(__('Write Us')) ?></h2>
                    <p><?= $escaper->escapeHtml(__('Jot us a note and we will get back to you as quickly as possible.')) ?></p>
                </div>

                <div class="forever-contact-grid">
                    <div class="field name required forever-contact-field">
                        <label class="label" for="name">
                            <span><?= $escaper->escapeHtml(__('Name')) ?></span>
                        </label>
                        <input
                            name="name"
                            id="name"
                            required
                            title="<?= $escaper->escapeHtmlAttr(__('Name')) ?>"
                            value="<?= $escaper->escapeHtmlAttr($contactHelper->getPostValue('name') ?: $contactHelper->getUserName()) ?>"
                            class="forever-contact-input"
                            type="text"
                            placeholder="<?= $escaper->escapeHtmlAttr(__('Name')) ?>"
                        >
                    </div>

                    <div class="field email required forever-contact-field">
                        <label class="label" for="email">
                            <span><?= $escaper->escapeHtml(__('Email')) ?></span>
                        </label>
                        <input
                            name="email"
                            id="email"
                            required
                            title="<?= $escaper->escapeHtmlAttr(__('Email')) ?>"
                            value="<?= $escaper->escapeHtmlAttr($contactHelper->getPostValue('email') ?: $contactHelper->getUserEmail()) ?>"
                            class="forever-contact-input"
                            type="email"
                            placeholder="<?= $escaper->escapeHtmlAttr(__('Email')) ?>"
                        >
                    </div>

                    <div class="field telephone forever-contact-field">
                        <label class="label" for="telephone">
                            <span><?= $escaper->escapeHtml(__('Phone Number')) ?></span>
                        </label>
                        <input
                            name="telephone"
                            id="telephone"
                            title="<?= $escaper->escapeHtmlAttr(__('Phone Number')) ?>"
                            value="<?= $escaper->escapeHtmlAttr($contactHelper->getPostValue('telephone')) ?>"
                            class="forever-contact-input"
                            type="text"
                            placeholder="<?= $escaper->escapeHtmlAttr(__('Phone Number')) ?>"
                        >
                    </div>

                    <div class="field comment required forever-contact-field forever-contact-field-wide">
                        <label class="label" for="comment">
                            <span><?= $escaper->escapeHtml(__('What is on your mind?')) ?></span>
                        </label>
                        <textarea
                            name="comment"
                            id="comment"
                            required
                            title="<?= $escaper->escapeHtmlAttr(__('What is on your mind?')) ?>"
                            class="forever-contact-input forever-contact-textarea"
                            cols="5"
                            rows="6"
                            placeholder="<?= $escaper->escapeHtmlAttr(__('What is on your mind?')) ?>"
                        ><?= $escaper->escapeHtml($contactHelper->getPostValue('comment')) ?></textarea>
                    </div>

                    <?= $block->getChildHtml('form.additional.info') ?>
                    <?= $recaptcha ? $recaptcha->getInputHtml(ReCaptcha::RECAPTCHA_FORM_ID_CONTACT) : '' ?>
                </div>
            </fieldset>

            <div class="forever-contact-actions">
                <?= $block->getBlockHtml('formkey') ?>
                <button type="submit" title="<?= $escaper->escapeHtmlAttr(__('Submit')) ?>" class="forever-contact-submit">
                    <span><?= $escaper->escapeHtml(__('Submit')) ?></span>
                </button>
            </div>

            <div class="forever-contact-after">
                <?= $block->getChildHtml('form.additional.after') ?>
                <?= $recaptcha ? $recaptcha->getLegalNoticeHtml(ReCaptcha::RECAPTCHA_FORM_ID_CONTACT) : '' ?>
            </div>
        </form>

        <?php if ($contactAddressHtml || $contactDetailsHtml): ?>
            <aside class="forever-contact-info" aria-label="<?= $escaper->escapeHtmlAttr(__('Contact Details')) ?>">
                <?= /** @noEscape */ $contactAddressHtml ?: $contactDetailsHtml ?>
            </aside>
        <?php endif; ?>
    </div>
</section>

<script>
    function initContactForm() {
        return {
            errors: 0,
            hasCaptchaToken: 0,
            submitForm() {
                const $form = document.querySelector('#<?= $escaper->escapeJs($formId) ?>');
                <?= $recaptcha ? $recaptcha->getValidationJsHtml(ReCaptcha::RECAPTCHA_FORM_ID_CONTACT) : '' ?>

                if (this.errors === 0) {
                    $form.submit();
                }
            }
        }
    }
</script>
