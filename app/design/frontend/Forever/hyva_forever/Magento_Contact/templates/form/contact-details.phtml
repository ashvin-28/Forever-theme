<?php
declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HeroiconsOutline;
use Hyva\Theme\ViewModel\StoreConfig;
use Magento\Framework\Escaper;

/** @var ViewModelRegistry $viewModels */
/** @var Escaper $escaper */

$storeConfig = $viewModels->require(StoreConfig::class);
$heroicons = $viewModels->require(HeroiconsOutline::class);
$storeName = (string) ($storeConfig->getStoreConfig('general/store_information/name') ?? '');
$street = (string) ($storeConfig->getStoreConfig('general/store_information/street_line1') ?? '');
$city = (string) ($storeConfig->getStoreConfig('general/store_information/city') ?? '');
$postcode = (string) ($storeConfig->getStoreConfig('general/store_information/postcode') ?? '');
$storePhoneNumber = (string) ($storeConfig->getStoreConfig('general/store_information/phone') ?? '');
$storeEmail = (string) ($storeConfig->getStoreConfig('trans_email/ident_general/email') ?? '');
?>
<div class="forever-contact-details">
    <h2><?= $escaper->escapeHtml(__('Contact Details')) ?></h2>
    <?php if ($storeName): ?>
        <h3><?= $escaper->escapeHtml($storeName) ?></h3>
    <?php endif; ?>
    <?php if ($street || $city || $postcode): ?>
        <address>
            <?php if ($street): ?>
                <?= $escaper->escapeHtml($street) ?><br>
            <?php endif; ?>
            <?php if ($city): ?>
                <?= $escaper->escapeHtml($city) ?><br>
            <?php endif; ?>
            <?php if ($postcode): ?>
                <?= $escaper->escapeHtml($postcode) ?>
            <?php endif; ?>
        </address>
    <?php endif; ?>

    <ul>
        <?php if ($storePhoneNumber): ?>
            <li>
                <?= $heroicons->phoneHtml('forever-contact-details-icon', 20, 20, ['aria-hidden' => 'true']) ?>
                <a href="tel:<?= $escaper->escapeHtmlAttr(preg_replace('/[^0-9+]/', '', $storePhoneNumber)) ?>">
                    <?= $escaper->escapeHtml($storePhoneNumber) ?>
                </a>
            </li>
        <?php endif; ?>
        <?php if ($storeEmail): ?>
            <li>
                <?= $heroicons->mailHtml('forever-contact-details-icon', 20, 20, ['aria-hidden' => 'true']) ?>
                <a href="mailto:<?= $escaper->escapeHtmlAttr($storeEmail) ?>">
                    <?= $escaper->escapeHtml($storeEmail) ?>
                </a>
            </li>
        <?php endif; ?>
    </ul>
</div>
