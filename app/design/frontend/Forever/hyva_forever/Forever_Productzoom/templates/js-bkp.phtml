    }
    .forever-pdp-gallery-main.forever-product-zoom-mode-inner.is-zoom-active > .forever-product-zoom-inner {
        opacity: 1;
    }

    .forever-pdp-gallery-main > .forever-product-zoom-tint {
        position: absolute;
