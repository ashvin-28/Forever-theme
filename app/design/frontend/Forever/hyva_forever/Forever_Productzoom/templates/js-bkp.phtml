<?php

declare(strict_types=1);

use Forever\Productzoom\Block\Zoom;
use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HyvaCsp;

/** @var Zoom $block */
/** @var ViewModelRegistry $viewModels */
/** @var HyvaCsp $hyvaCsp */

$hyvaCsp = $viewModels->require(HyvaCsp::class);
$helper = $block->getData('helper');
$data = $helper ? $helper->getConfigModule('general') : [];
$data = is_array($data) ? $data : [];

$asBool = static function (mixed $value, bool $default = false): bool {
    if (is_bool($value)) {
        return $value;
    }

    $normalized = strtolower(trim((string) $value));
    if (in_array($normalized, ['1', 'true', 'yes', 'on'], true)) {
        return true;
    }
    if (in_array($normalized, ['0', 'false', 'no', 'off', ''], true)) {
        return false;
    }

    return $default;
};

$asNumber = static function (mixed $value, float $default, float $minimum, float $maximum): float {
    if (!is_numeric($value)) {
        return $default;
    }

    return max($minimum, min($maximum, (float) $value));
};

$asColor = static function (mixed $value, string $default): string {
    $color = trim((string) $value);

    return preg_match('/^(?:#[a-fA-F0-9]{3,8}|[a-zA-Z]+)$/', $color) ? $color : $default;
};

$zoomType = (string) ($data['zoomType'] ?? 'inner');
if (!in_array($zoomType, ['window', 'inner', 'lens'], true)) {
    $zoomType = 'inner';
}

$cursor = (string) ($data['cursor'] ?? 'default');
if (!in_array($cursor, ['default', 'cursor', 'crosshair'], true)) {
    $cursor = 'default';
}

$zoomConfig = [
    'enabled' => false,
    'responsive' => $asBool($data['responsive'] ?? false),
    'scrollZoom' => $asBool($data['scrollZoom'] ?? false),
    'zoomType' => $zoomType,
    'zoomWindowPosition' => (int) $asNumber($data['zoomWindowPosition'] ?? 1, 1, 1, 4),
    'zoomWindowFadeIn' => $asBool($data['zoomWindowFadeIn'] ?? true, true),
    'zoomWindowFadeOut' => $asBool($data['zoomWindowFadeOut'] ?? true, true),
    'zIndex' => (int) $asNumber($data['zIndex'] ?? 99, 99, 1, 9999),
    'cursor' => $cursor,
    'borderSize' => $asNumber($data['borderSize'] ?? 1, 1, 0, 10),
    'borderColour' => $asColor($data['borderColour'] ?? '#666', '#666'),
    'easing' => $asBool($data['easing'] ?? false),
    'easingDuration' => (int) $asNumber($data['easingDuration'] ?? 200, 200, 0, 2000),
    'lensShape' => ($data['lensShape'] ?? 'square') === 'round' ? 'round' : 'square',
    'lensBorder' => $asNumber($data['lensBorder'] ?? 1, 1, 0, 10),
    'lensColour' => $asColor($data['lensColour'] ?? '#fff', '#fff'),
    'lensOpacity' => $asNumber($data['lensOpacity'] ?? 0.4, 0.4, 0, 1),
    'tint' => $asBool($data['tint'] ?? false),
    'tintColour' => $asColor($data['tintColour'] ?? '#333', '#333'),
    'tintOpacity' => $asNumber($data['tintOpacity'] ?? 0.4, 0.4, 0, 1),
];
?>
<?php if ($zoomConfig['enabled']): ?>
<style>
