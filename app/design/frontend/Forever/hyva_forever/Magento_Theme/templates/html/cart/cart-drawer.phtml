                            :aria-label="productAriaLabel(item, $el.dataset.ariaLabel)"
                            :title="item.product_name"
                        >
                            <img
                                :src="item.product_image.src"
                                :width="item.product_image.width"
                                :height="item.product_image.height"
                                loading="lazy"
                                :alt="item.product_name"
                            >
                        </a>
                    </template>
                    <template x-if="productIsNotVisibleInSite(item)">
                        <div class="forever-cart-drawer-photo">
                            <img
                                :src="item.product_image.src"
                                :width="item.product_image.width"
                                :height="item.product_image.height"
                                loading="lazy"
                                :alt="item.product_name"
                            >
                        </div>
                    </template>

                    <div class="forever-cart-drawer-item-content">
                        <div class="forever-cart-drawer-item-main">
                            <p class="forever-cart-drawer-product-name">
                                <span x-text="item.qty"></span> x <strong x-html="item.product_name"></strong>
                            </p>
                            <span class="forever-cart-drawer-price" x-html="item.product_price"></span>
                        </div>

                        <template x-if="showDetails(item)">
                            <dl class="forever-cart-drawer-options">
                                <template x-if="showSku">
                                    <div>
                                        <dt><?= $escaper->escapeHtml(__('Sku')) ?></dt>
                                        <dd x-html="item.product_sku"></dd>
                                    </div>
                                </template>
                                <template x-for="option in item.options">
                                    <div>
                                        <dt x-text="option.label"></dt>
                                        <dd x-html="option.value"></dd>
                                    </div>
                                </template>
                            </dl>
                        </template>

                        <div class="forever-cart-drawer-item-actions">
                            <a
                                :href="item.configure_url"
                                x-show="productIsNotGroupedAndVisibleInSite(item)"
                                class="forever-cart-drawer-action"
                                data-aria-label="<?= $escaper->escapeHtmlAttr(__('Edit product "%0"')) ?>"
                                :aria-label="productAriaLabel(item, $el.dataset.ariaLabel)"
                            >
                                <?= $lucideIcons->pencilHtml('', 18, 18, ['aria-hidden' => 'true']); ?>
                            </a>
                            <button
                                type="button"
                                class="forever-cart-drawer-action"
                                @click="requestDeleteItem(item)"
                                data-aria-label="<?= $escaper->escapeHtmlAttr(__('Remove product "%0" from cart')) ?>"
                                :aria-label="productAriaLabel(item, $el.dataset.ariaLabel)"
                            >
                                <?= $lucideIcons->trashHtml('', 18, 18, ['aria-hidden' => 'true']); ?>
                            </button>
                        </div>

                        <template x-if="item.message">
                            <div class="message error" x-text="item.message"></div>
                        </template>
                    </div>
                </li>
            </template>
        </ul>
    </template>

    <?= $block->getChildHtml('cart-drawer.bottom'); ?>

    <template x-if="itemsCount">
        <div class="forever-cart-drawer-footer">
            <?= $block->getChildHtml('cart-drawer.totals.before'); ?>

            <dl class="forever-cart-drawer-subtotal">
                <dt><?= $escaper->escapeHtml(__('Subtotal')) ?></dt>
                <dd x-html="cart.subtotal"></dd>
            </dl>

            <a
                href="<?= $escaper->escapeUrl($block->getUrl('checkout')) ?>"
                class="forever-cart-drawer-checkout"
            >
                <?= $escaper->escapeHtml(__('Proceed to Checkout')) ?>
            </a>
            <a
                href="<?= $escaper->escapeUrl($block->getUrl('checkout/cart')) ?>"
                class="forever-cart-drawer-viewcart"
            >
                <?= $escaper->escapeHtml(__('View and Edit Cart')) ?>
            </a>
            <div x-html="getSectionDataExtraActions()"></div>
            <?= $block->getChildHtml('extra_actions'); ?>
        </div>
    </template>

    <?= $block->getChildHtml('loading') ?>

    <div
        class="forever-cart-remove-confirm"
        x-show.important="isDeleteConfirmOpen"
        x-transition.opacity.duration.150ms
        x-cloak
        @keydown.escape.window="cancelDeleteItem"
    >
        <div
            class="forever-cart-remove-confirm-backdrop"
            aria-hidden="true"
            @click="cancelDeleteItem"
