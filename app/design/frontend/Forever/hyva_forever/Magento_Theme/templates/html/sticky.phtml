<script>
    window.foreverHyvaStickyHeader = {
        enabled: <?= $stickyenable ? 'true' : 'false' ?>,
        type: '<?= $block->escapeJs($stickytype) ?>',
        headerStyle: '<?= $block->escapeJs($headerStyle) ?>'
    };

    (function () {
        'use strict';

        var config = window.foreverHyvaStickyHeader || {};
        var desktopQuery = window.matchMedia('(min-width: 1025px)');
        var threshold = 100;

        function getHeader() {
            return document.getElementById('header');
        }

        function getStickyTarget(header) {
            if (config.type === 'sticky-2') {
                return header.querySelector('.forever-header-main') || header;
            }

            return header;
        }

        function clearStickyState() {
            if (!document.body) {
                return;
            }

            document.body.classList.remove(
                'sticky-header-active',
                'sticky-header2-active',
                'forever-sticky-header-active'
            );
            document.documentElement.style.removeProperty('--forever-sticky-header-height');
        }

        function setStickyHeight(header) {
            window.requestAnimationFrame(function () {
                var target = getStickyTarget(header);
                var height = target ? Math.ceil(target.getBoundingClientRect().height) : 0;
                document.documentElement.style.setProperty('--forever-sticky-header-height', height + 'px');
            });
        }

        function updateStickyHeader() {
            if (!document.body) {
                return;
            }

            var header = getHeader();
            var enabled = Boolean(config.enabled);
            var shouldStick = enabled && header && desktopQuery.matches && window.scrollY >= threshold;
            var isSticky2 = config.type === 'sticky-2';

            if (!shouldStick) {
                clearStickyState();
                return;
            }

            document.body.classList.add('forever-sticky-header-active');
            document.body.classList.toggle('sticky-header-active', !isSticky2);
            document.body.classList.toggle('sticky-header2-active', isSticky2);
            setStickyHeight(header);
        }

        if (!config.enabled) {
            clearStickyState();
            return;
        }

        window.addEventListener('scroll', updateStickyHeader, {passive: true});
        window.addEventListener('resize', updateStickyHeader);

        if (desktopQuery.addEventListener) {
            desktopQuery.addEventListener('change', updateStickyHeader);
        } else if (desktopQuery.addListener) {
            desktopQuery.addListener(updateStickyHeader);
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', updateStickyHeader, {once: true});
        } else {
            updateStickyHeader();
        }
    }());
</script>
<?php $hyvaCsp->registerInlineScript() ?>
