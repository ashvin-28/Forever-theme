<script>
    function initHeader() {
        return {
            cart: {},
            customer: {},
            isCartOpen: false,
            customerMenuOpen: false,
            customerSectionReady: false,
            customerRefreshPending: false,
            mobileSearchOpen: false,
            getData(data) {
                this.cart = data.cart ?? {};
                this.refreshCustomerSection(data.customer ?? {});
            },
            summaryCount() {
                return this.cart.summary_count || 0;
            },
            isCustomerSignedIn() {
                return this.customerSectionReady
                    && Boolean(this.customer && (this.customer.firstname || this.customer.fullname));
            },
            customerName() {
                const name = this.customer.firstname || this.customer.fullname || '';

                if (!name) {
                    return '<?= $escaper->escapeJs(__('My Account')) ?>';
                }

                return hyva.str('<?= $escaper->escapeJs(__('%1!', '%1')) ?>', name);
            },
            cartAriaLabel() {
                return '<?= $escaper->escapeJs($showMiniCart ? __('Toggle minicart') : __('View cart')) ?>, ' +
                    (this.isCartEmpty() ? '<?= $escaper->escapeJs(__('Cart is empty')) ?>' : (
                        Math.abs(this.summaryCount()) > 1
                            ? hyva.str('<?= $escaper->escapeJs(__('%1 items')) ?>', this.summaryCount())
                            : hyva.str('<?= $escaper->escapeJs(__('%1 item')) ?>', this.summaryCount())
                    ))
            },
            isCartEmpty() {
                return !this.cart.summary_count;
            },
            toggleCart() {
                this.isCartOpen = this.$event.detail?.isOpen ?? true;
                this.customerMenuOpen = false;
                this.$dispatch('toggle-cart', {isOpen: this.isCartOpen});
            },
            toggleCustomerMenu() {
                this.customerMenuOpen = !this.customerMenuOpen;
            },
            closeCustomerMenu() {
                this.customerMenuOpen = false;
            },
            handleCustomerLogout() {
                this.clearCustomerState();
            },
            clearCustomerState() {
                this.customer = {};
                this.customerSectionReady = true;
                this.customerMenuOpen = false;
                this.persistCustomerSection({});
            },
            refreshCustomerSection(fallbackCustomer) {
                if (this.customerRefreshPending) {
                    return;
                }

                this.customerRefreshPending = true;

                fetch('<?= $escaper->escapeJs($customerSectionUrl) ?>', {
                    method: 'GET',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                    .then(response => response.ok ? response.json() : null)
                    .then(data => {
                        const freshCustomer = data && data.customer ? data.customer : {};

                        this.customer = freshCustomer;
                        this.customerSectionReady = true;
                        this.customerRefreshPending = false;
                        this.persistCustomerSection(freshCustomer);

                        if (!this.isCustomerSignedIn()) {
                            this.customerMenuOpen = false;
                        }
                    })
                    .catch(() => {
                        this.customer = fallbackCustomer || {};
                        this.customerSectionReady = true;
                        this.customerRefreshPending = false;

                        if (!this.isCustomerSignedIn()) {
                            this.customerMenuOpen = false;
                        }
                    });
            },
            persistCustomerSection(customer) {
                const browserStorage = hyva.getBrowserStorage && hyva.getBrowserStorage();

                if (!browserStorage) {
                    return;
                }

                try {
                    const privateContent = JSON.parse(browserStorage.getItem('mage-cache-storage') || '{}') || {};
                    privateContent.customer = customer || {};
                    browserStorage.setItem('mage-cache-storage', JSON.stringify(privateContent));
                } catch (error) {
                    // Private content storage is best-effort only.
                }
            },
            toggleMobileSearch() {
                this.mobileSearchOpen = !this.mobileSearchOpen;
                this.customerMenuOpen = false;

                if (this.mobileSearchOpen) {
                    this.$nextTick(() => this.$dispatch('search-open'));
                }
            }
        }
    }

    window.addEventListener('alpine:init', () => {
        Alpine.data('initHeader', initHeader);
    }, {once: true})
</script>
