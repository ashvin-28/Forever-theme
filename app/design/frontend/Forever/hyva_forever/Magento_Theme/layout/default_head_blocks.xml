<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="css/styles.css"/>
        <css src="css/back-to-top.css"/>
        <css src="css/responsive-fix.css"/>
        
        <remove src="Magento_Theme::css/owl.carousel.css"/>
        <remove src="Magento_Theme::css/owl.theme.default.css"/>
        <remove src="Magento_Theme::js/custom.js"/>
    </head>
    <referenceBlock name="head.additional">
        <block class="Magento\Framework\View\Element\Text" name="dynamic.css">
            <arguments>
                <argument name="label" xsi:type="string">Adding Dynamic CSS</argument>
                <argument name="text" xsi:type="helper" helper="Forever\Core\Helper\Cssconfig::getDynamicCssLink"/>
            </arguments>
        </block>
    </referenceBlock>
</page>
