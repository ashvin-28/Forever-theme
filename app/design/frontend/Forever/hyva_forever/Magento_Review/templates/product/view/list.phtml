<?php
/**
 * Forever PDP review list using Hyva view models and Magento review data.
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\LucideIcons;
use Magento\Framework\Escaper;
use Magento\Review\Block\Product\View as ProductReview;
use Magento\Theme\Block\Html\Pager;

/** @var ProductReview $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */
/** @var Pager $toolbar */

/** @var LucideIcons $lucideIcons */
$lucideIcons = $viewModels->require(LucideIcons::class);
$starIconSize = (int) ($block->getData('rating_icon_size') ?: 16);
$reviewCollection = $block->getReviewsCollection();

if ($toolbar = $block->getChildBlock('review_list.toolbar')) {
    $toolbar->setCollection($reviewCollection);
}

$reviewCollection->load()->addRateVotes();
$items = $reviewCollection->getItems();
$format = $block->getDateFormat() ?: \IntlDateFormatter::SHORT;
$formatLong = $block->getDateFormat() ?: \IntlDateFormatter::LONG;
$productName = (string) $block->getProduct()->getName();
?>

<?php if ($items): ?>
    <div
        class="forever-customer-reviews"
        id="customer-review-list"
        aria-label="<?= $escaper->escapeHtmlAttr(__('Customer Reviews')) ?>"
        tabindex="-1"
        role="group"
    >
        <?php if (!$block->getHideTitle()): ?>
            <h2><?= $escaper->escapeHtml(__('Customer Reviews')) ?></h2>
        <?php endif; ?>

        <div class="forever-customer-review-items">
            <?php foreach ($items as $review): ?>
                <article
                    class="forever-customer-review"
                    itemscope
                    itemprop="review"
                    itemtype="https://schema.org/Review"
                >
                    <?php if (count($review->getRatingVotes())): ?>
                        <div class="forever-customer-review-ratings">
                            <?php foreach ($review->getRatingVotes() as $vote): ?>
                                <?php
                                $rating = (float) $vote->getPercent();
                                $ratingSteps = 5;
                                $starsFilled = max(0, min($ratingSteps, (int) floor($rating / 100 * $ratingSteps)));
                                $starsEmpty = $ratingSteps - $starsFilled;
                                ?>
                                <div
                                    class="forever-customer-review-rating"
                                    itemprop="reviewRating"
                                    itemscope
                                    itemtype="https://schema.org/Rating"
                                >
                                    <span class="forever-customer-review-rating-label">
                                        <?= $escaper->escapeHtml($vote->getRatingCode()) ?>
                                    </span>
                                    <meta itemprop="ratingValue" content="<?= $escaper->escapeHtmlAttr((string) $starsFilled) ?>">
                                    <div
                                        class="forever-customer-review-stars"
                                        role="img"
                                        aria-label="<?= $escaper->escapeHtmlAttr(
                                            __('%1 rating. %2 out of %3 stars', $productName, $starsFilled, $ratingSteps)
                                        ) ?>"
                                    >
                                        <?php for ($i = 0; $i < $starsFilled; $i++): ?>
                                            <?= $lucideIcons->starHtml('fill-current', $starIconSize, $starIconSize, ['aria-hidden' => 'true']) ?>
                                        <?php endfor; ?>
                                        <?php for ($i = 0; $i < $starsEmpty; $i++): ?>
                                            <?= $lucideIcons->starHtml('', $starIconSize, $starIconSize, ['aria-hidden' => 'true']) ?>
                                        <?php endfor; ?>
                                    </div>
                                </div>
                            <?php endforeach; ?>
                        </div>
                    <?php endif; ?>

                    <div class="forever-customer-review-content">
                        <div class="forever-customer-review-title" itemprop="name">
                            <?= $escaper->escapeHtml($review->getTitle()) ?>
                        </div>
                        <div class="forever-customer-review-detail" itemprop="description">
                            <?= /** @noEscape */ nl2br($escaper->escapeHtml($review->getDetail())) ?>
                        </div>
                        <div class="forever-customer-review-meta">
                            <span><?= $escaper->escapeHtml(__('Review by')) ?></span>
                            <strong itemprop="author" itemscope itemtype="https://schema.org/Person">
                                <span itemprop="name"><?= $escaper->escapeHtml($review->getNickname()) ?></span>
                            </strong>
                            <time
                                itemprop="datePublished"
                                datetime="<?= $escaper->escapeHtmlAttr($block->formatDate($review->getCreatedAt(), $format)) ?>"
                            >
                                <span class="sr-only">
                                    <?= $escaper->escapeHtml($block->formatDate($review->getCreatedAt(), $formatLong)) ?>
                                </span>
                                <span aria-hidden="true">
                                    <?= $escaper->escapeHtml($block->formatDate($review->getCreatedAt(), $format)) ?>
                                </span>
                            </time>
                        </div>
                    </div>
                </article>
            <?php endforeach; ?>
        </div>

        <?php if ($toolbar): ?>
            <div class="toolbar review-toolbar">
                <?= $toolbar->toHtml() ?>
            </div>
        <?php endif; ?>
    </div>
<?php endif; ?>
