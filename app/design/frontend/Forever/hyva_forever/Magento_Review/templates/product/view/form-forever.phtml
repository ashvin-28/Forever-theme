                                                <span><?= $escaper->escapeHtml($rating->getRatingCode()) ?></span>
                                            </legend>
                                            <div
                                                class="control review-control-vote rating-summary"
                                                x-data="{ clickedRatingId: 0 }"
                                            >
                                                <?php $iterator = 1; ?>
                                                <?php foreach ($rating->getOptions() as $option): ?>
                                                    <label
                                                        class="forever-review-star-label rating-<?= (int) $iterator ?>"
                                                        for="<?= $escaper->escapeHtmlAttr($rating->getRatingCode() . '_' . $option->getValue()) ?>"
                                                        title="<?= $escaper->escapeHtmlAttr(__('%1 %2', $iterator, $iterator > 1 ? __('stars') : __('star'))) ?>"
                                                    >
                                                        <?= $lucideIcons->starHtml(
                                                            'forever-review-star',
                                                            $starIconSize,
                                                            $starIconSize,
                                                            [
                                                                'aria-hidden' => 'true',
                                                                ':class' => (int) $iterator . " <= clickedRatingId ? 'is-selected' : ''"
                                                            ]
                                                        ); ?>
                                                        <input
                                                            name="ratings[<?= $escaper->escapeHtmlAttr($rating->getId()) ?>]"
                                                            id="<?= $escaper->escapeHtmlAttr($rating->getRatingCode() . '_' . $option->getValue()) ?>"
                                                            class="forever-review-star-input"
                                                            type="radio"
                                                            <?php if ($iterator === 1): ?>required<?php endif; ?>
                                                            value="<?= $escaper->escapeHtmlAttr($option->getId()) ?>"
                                                            aria-labelledby="<?= $escaper->escapeHtmlAttr($rating->getRatingCode()) ?>_rating_label"
                                                            @click="clickedRatingId = <?= (int) $iterator ?>"
                                                        >
                                                        <span class="sr-only">
                                                            <?= $escaper->escapeHtml(__('%1 %2', $iterator, $iterator > 1 ? __('stars') : __('star'))) ?>
                                                        </span>
                                                    </label>
