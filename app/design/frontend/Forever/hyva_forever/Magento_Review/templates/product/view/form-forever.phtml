                class="review-form"
                id="<?= $escaper->escapeHtmlAttr($formId) ?>"
                action=""
                x-data="initForeverReviewForm()"
                x-defer="intersect"
                @submit.prevent="submitForm()"
            >
                <?= $block->getChildHtml('form_fields_before') ?>
                <?= $recaptcha ? $recaptcha->getInputHtml(ReCaptcha::RECAPTCHA_FORM_ID_PRODUCT_REVIEW) : '' ?>

                <fieldset class="fieldset review-fieldset">
                    <legend class="legend review-legend">
                        <span><?= $escaper->escapeHtml(__("You're reviewing:")) ?></span>
                        <strong><?= $escaper->escapeHtml($block->getProductInfo()->getName()) ?></strong>
                    </legend>

                    <?php if ($block->getRatings() && $block->getRatings()->getSize()): ?>
                        <fieldset class="field required review-field-ratings">
