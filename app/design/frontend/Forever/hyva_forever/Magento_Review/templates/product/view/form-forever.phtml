                    <?php endif; ?>

                    <div class="field review-field-nickname required review-fields">
                        <label for="nickname_field" class="label">
                            <span><?= $escaper->escapeHtml(__('Nickname')) ?></span>
                            <span class="required-marker">*</span>
                        </label>
                        <div class="control">
                            <input
