<?php
declare(strict_types=1);

/** @var \Forever\Blog\Block\TagView $block */
/** @var \Magento\Framework\Escaper $escaper */

$pathParts = array_values(array_filter(explode('/', trim((string) $block->getRequest()->getPathInfo(), '/'))));
$tagviewUrlKey = (string) end($pathParts);
if ($tagviewUrlKey === '' || $tagviewUrlKey === 'view') {
    foreach ($block->getRequest()->getParams() as $key => $value) {
        $tagviewUrlKey = (string) $key;
    }
}
$viewModel = $block->getViewModel();
$isEnableModule = (int) $viewModel->getConfig();
// $tagCompatibility = \Magento\Framework\App\ObjectManager::getInstance()
//     ->get(\Hyva\ForeverBlog\Model\TagCompatibility::class);
// $collections = $tagCompatibility->getPostCollectionForSlug($tagviewUrlKey);
// After
$collections = $block->getTagPostList($tagviewUrlKey);
?>
<?php if ($isEnableModule === 1): ?>
    <div class="blog-list-container">
        <?php if ($collections && count($collections)): ?>
            <?php foreach ($collections as $item): ?>
                <article class="blog-content">
                    <?php $imageUrl = $item->getBlogImage()
                        ? $viewModel->getMediaUrl() . 'blog/image/' . $item->getBlogImage()
                        : $block->getPlaceHolderImage(); ?>
                    <div class="blog-image">
                        <a href="<?= $escaper->escapeUrl($block->getViewUrl($item->getUrlKey())) ?>">
                            <img src="<?= $escaper->escapeUrl($imageUrl) ?>"
                                 alt="<?= $escaper->escapeHtmlAttr($item->getTitle()) ?>"
                                 loading="lazy"
                                 width="1440"
                                 height="900">
                        </a>
                    </div>
                    <div class="blog-description">
                        <div class="blog-title">
                            <h2>
                                <a href="<?= $escaper->escapeUrl($block->getViewUrl($item->getUrlKey())) ?>">
                                    <?= $escaper->escapeHtml($item->getTitle()) ?>
                                </a>
                            </h2> 
                        </div>
                        <div class="blog-plublish-date">
                            <span><?= $escaper->escapeHtml($item->getPublishTime()) ?></span>
                            <?php if ($item->getAuthor()): ?>
                                <span><?= $escaper->escapeHtml($item->getAuthor()) ?></span>
                            <?php endif; ?>
                        </div>
                        <div class="blog-short-content">
                            <div><?= /* @noEscape */ $item->getContentHeading(); ?></div>
                        </div>
                        <a class="read-more-btn action primary"
                           href="<?= $escaper->escapeUrl($block->getViewUrl($item->getUrlKey())) ?>">
                            <?= $escaper->escapeHtml(__('Read More...')) ?>
                        </a>
                    </div>
                </article>
            <?php endforeach; ?>
        <?php else: ?>
            <div class="message info empty">
                <span><?= $escaper->escapeHtml(__('No records found for this tag.')); ?></span>
            </div>
        <?php endif; ?>
    </div>
<?php endif; ?>
