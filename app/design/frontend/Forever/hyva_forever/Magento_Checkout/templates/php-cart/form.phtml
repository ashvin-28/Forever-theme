declare(strict_types=1);

// phpcs:disable Magento2.Templates.ThisInTemplate

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\Cart\ItemOutput;
use Hyva\Theme\ViewModel\Modal;
use Magento\Checkout\Block\Cart\Grid;
use Magento\Checkout\ViewModel\Cart as CartViewModel;
use Magento\Framework\Escaper;

/** @var Grid $block */
/** @var ViewModelRegistry $viewModels */
/** @var Escaper $escaper */

/** @var CartViewModel $cartViewModel */
$cartViewModel = $viewModels->require(CartViewModel::class);

/** @var Modal $modalViewModel */
$modalViewModel = $viewModels->require(Modal::class);

/** @var ItemOutput $cartItemOutputViewModel */
$cartItemOutputViewModel = $viewModels->require(ItemOutput::class);

$mergedCells = ($cartItemOutputViewModel->isItemPriceDisplayBoth() ? 2 : 1);
?>
<?= $block->getChildHtml('form_before') ?>
<form
    id="form-validate"
    class="form form-cart"
    action="<?= $escaper->escapeUrl($block->getUrl('checkout/cart/updatePost')) ?>"
    method="post"
    @submit.prevent="postCart"
>
    <?= $block->getBlockHtml('formkey') ?>
    <div class="<?= $mergedCells == 2 ? 'cart detailed' : 'cart' ?>">
        <fieldset id="shopping-cart-table">
            <legend class="sr-only">
                <h2><?= $escaper->escapeHtml(__('Shopping Cart Items')) ?></h2>
            </legend>
            <div class="hidden md:flex w-full bg-[#f5f5f5] py-4 mb-4 text-[13px] font-bold uppercase tracking-widest text-center text-gray-800">
                <div class="w-2/5 text-left pl-4"><?= $escaper->escapeHtml(__('Item')) ?></div>
                <div class="w-1/5"><?= $escaper->escapeHtml(__('Price')) ?></div>
                <div class="w-1/5"><?= $escaper->escapeHtml(__('Qty')) ?></div>
                <div class="w-1/5 text-right pr-4"><?= $escaper->escapeHtml(__('Subtotal')) ?></div>
            </div>
            <ul>
                <?php foreach ($block->getItems() as $item): ?>
                    <li class="py-6 border-b border-gray-300 first:pt-0 last:pb-0 last:border-b-0">
                        <?= $block->getItemHtml($item) ?>
                    </li>
                <?php endforeach ?>
            </ul>
        </fieldset>
        <?php if ($block->getPagerHtml()): ?>
            <div class="toolbar cart-products-toolbar mt-8">
                <?= $block->getPagerHtml() ?>
            </div>
        <?php endif ?>
    </div>
    <div class="actions-toolbar cart actions mt-6 flex justify-end items-center gap-4">
        <?php if ($cartViewModel->isClearShoppingCartEnabled()): ?>
            <?= $block->getChildHtml('checkout.cart.form.clear') ?>
        <?php endif ?>

        <button
            type="submit"
            name="update_cart_action"
            value="update_qty"
            class="btn action update cursor-pointer transition-all duration-300 ease-in-out bg-[#dda245] hover:bg-[#c99538] hover:shadow-md border-0 text-white font-semibold py-3 px-6 shadow-none"
            data-cart-item-update
        ><?= $escaper->escapeHtml(__('Update Shopping Cart')) ?></button>

        <?= $block->getChildHtml('checkout.cart.order.actions') ?>
    </div>
</form>
<?= $block->getChildHtml('shopping.cart.table.after') ?>
