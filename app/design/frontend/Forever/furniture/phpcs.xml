<?xml version="1.0"?>
<ruleset name="ForeverFurnitureTheme">
    <description>Magento2 coding standard for the Forever/furniture theme.</description>

    <rule ref="Magento2">
        <!--
            ID selectors targeting core Magento-generated markup that cannot be
            renamed without overriding core templates:
            #wishlist-sidebar, #product-addtocart-button, #product-review-container,
            #opc-sidebar, #opc-shipping_method, #checkout-step-shipping,
            #checkout-step-shipping_method, #checkout-payment-method-load,
            #customer-email-fieldset, #co-shipping-method-form,
            #shopping-cart-table, #shipping-zip-form, #block-shipping,
            #newsletter-validate-detail-modal, #newsletter-error,
            #layer-product-list, #reviews, #block_4,
            and ol#checkoutSteps (core Magento checkout element).
        -->
        <exclude name="Magento2.Less.AvoidId"/>

        <!--
            False positive: this sniff misidentifies any selector ending in a
            pseudo-class/element before the opening brace (e.g. "a:hover {",
            ":not(:last-child) {") as a declaration missing a semicolon.
        -->
        <exclude name="Magento2.Less.SemicolonSpacing"/>

        <!--
            Magento's own base UI library mixin definitions declare named
            parameters with defaults across multiple lines. This sniff misreads
            each parameter as a misplaced variable declaration. Also covers
            scoped variable declarations inside media-width mixin guards which
            are correctly placed at the top of their enclosing block.
        -->
        <exclude name="Magento2.Less.Variables"/>

        <!--
            Same multi-line named-parameter mixin definitions trigger false
            "newline after colon" warnings for each parameter's default-value
            colon.
        -->
        <exclude name="Magento2.Less.ColonSpacing"/>

        <!--
            Class names tied to CMS block content, core Magento templates, and
            third-party module markup (e.g. footer_common_container,
            sales-end-main__title, payment_icon, footer_inner1, footer_inner2,
            additional-info, flex-direction-column, justify-content-between,
            all-categories-section__content__heading) are literal identifiers
            referenced from imported CMS blocks, core templates, or JS.
            Renaming them would break functionality.
        -->
        <exclude name="Magento2.Less.ClassNaming"/>

        <!--
            Selector contains uppercase symbols: solely from core Magento's
            own "ol#checkoutSteps" element id which cannot be renamed.
        -->
        <exclude name="Magento2.Less.TypeSelectors"/>

        <!--
            False positive: commas inside mixin definition named-parameter
            lists are misread as CSS selector-list delimiters needing a line
            break.
        -->
        <exclude name="Magento2.Less.SelectorDelimiter"/>
    </rule>

    <!--
        Long single-line mixin calls can exceed the generic line-length limit.
        This is a readability preference, not a defect, for LESS partials.
    -->
    <rule ref="Generic.Files.LineLength">
        <exclude-pattern>*.less</exclude-pattern>
    </rule>

    <!--
        False positive in _extend.less: the sniff's property-collection window
        does not reset cleanly across consecutive closing braces, causing it to
        compare unrelated properties and report a sorting violation where none
        exists.
    -->
    <rule ref="Magento2.Less.PropertiesSorting">
        <exclude-pattern>*/Magento_Cms/web/css/source/_extend\.less</exclude-pattern>
    </rule>

</ruleset>
